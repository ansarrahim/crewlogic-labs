# NEXUS-AI live chat — required for the chat widget to respond
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Contact form email delivery — optional, form shows a clear error if unset
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender address once you've added your domain in Resend.
# Defaults to Resend's shared onboarding@resend.dev sender if unset.
CONTACT_FROM_EMAIL=

# Error monitoring — optional, no-ops if unset
# Create a free project at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Only needed if your org lives on a region-specific cluster (check the
# "region_url" in your auth token, or the ingest host in your DSN — e.g.
# "https://de.sentry.io" for EU-region orgs). Defaults to https://sentry.io.
SENTRY_API_BASE_URL=

# Live usage stats + admin dashboard leads chart — optional, both show a
# clean "not connected" state if unset.
# Free tier, no card: https://console.upstash.com — create a Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin dashboard (/admin/metrics) — required to use it at all
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
